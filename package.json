{
  "name": "p3-executor-dev",
  "private": true,
  "type": "module",
  "description": "Development workspace for the p3-stack Executor app. Only app/ is deployed.",
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:app": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 app/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check:bundle": "node --import tsx scripts/check-bundle.ts",
    "verify": "pnpm typecheck:app && pnpm typecheck && pnpm test && pnpm check:bundle"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "apps": "0.0.1-beta.74",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
